# AI: prefer gemini | openai (falls back to the other if its key is missing)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-5.4-mini
RATE_LIMIT_PER_MINUTE=20

# Database (Neon Postgres) and sessions
DATABASE_URL=
AUTH_SECRET=   # openssl rand -base64 32

# GitHub (optional): a token with no scopes raises Search API limits; demo accounts read this user's public activity
GITHUB_TOKEN=
DEMO_GITHUB_USERNAME=
