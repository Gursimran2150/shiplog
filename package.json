{
  "name": "shiplog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "check": "pnpm lint && pnpm lint:deadcode && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "lint:deadcode": "knip"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "knip": "5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
